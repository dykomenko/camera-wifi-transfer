<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="App.Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>
    <style name="App.Button.Primary">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
    </style>
    <style name="App.Button.Tonal">
        <item name="android:background">@drawable/btn_tonal_bg</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="App.Button.Text">
        <item name="android:background">@drawable/btn_text_bg</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
